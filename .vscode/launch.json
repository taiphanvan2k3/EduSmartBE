{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "AuthService",
            "type": "coreclr",
            "request": "launch",

            // !!!NOTE: giá trị của preLaunchTask phải trùng với label của task trong tasks.json
            "preLaunchTask": "AuthService",
            "program": "${workspaceFolder}/AuthService/bin/Debug/net8.0/AuthService.dll",
            "args": [],
            "cwd": "${workspaceFolder}/AuthService",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": "<abc>Service",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "...Service",
            "program": "${workspaceFolder}/AuthService/bin/Debug/net8.0/AuthService.dll",
            "args": [],
            "cwd": "${workspaceFolder}/AuthService",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        },
    ],
    "compounds": [
        {
            "name": "All Services",
            "configurations": ["AuthService", "<abc>Service"],
            "stopAll": true
        }
    ]
}