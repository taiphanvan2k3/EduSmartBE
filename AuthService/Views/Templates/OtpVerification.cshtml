@using AuthService.Services.MailSender.Schemas
@model OtpVerificationMailBody

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EduSmart - OTP Verification</title>
</head>

<body>
    <h1>OTP Verification</h1>
    <h2>Hello @Model.ToUserName!</h2>
    <p>We received a request to send you a One-Time Password (OTP) for your account.</p>
    <h2>Your OTP is: <strong>@Model.OtpCode</strong></h2>
    <p>Please enter this OTP to verify your identity. This OTP is valid in 2 minutes.</p>
    <p>If you did not request this, please ignore this email.</p>
    <p>Thank you!</p>
</body>

</html>
