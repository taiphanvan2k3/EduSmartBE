{
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Information"
            }
        },
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "File",
                "Args": {
                    "path": "Logs/UserService.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 7,
                    "rollOnFileSizeLimit": true
                }
            }
        ]
    },
    "JWTSetting": {
        "SecretKey": "T8tHezuFsRfZYj5dyhUcMxmvxmldsigmoreeyedpqlakwefzwwd",
        "Issuer": "SmartEdu.AuthService",
        "Audience": "SmartEdu.Clients",
        "TokenExpirationInMinutes": 15,
        "RefreshTokenExpirationInDays": 7
    },
    "AllowedHosts": "*"
}